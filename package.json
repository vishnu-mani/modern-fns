    "javascript",
    "typescript",
    "utility-library",
    "javascript-utilities",
    "typescript-utilities",
    "lodash-alternative",
    "functional-programming",
    "tree-shaking",
    "immutable",
    "frontend",
    "utilities",
    "diff",
    "deep-diff",
    "query-string",
    "url",
    "object-path",
    "esm"
  ],
  "license": "MIT",
  "author": "Vishnu M",
  "repository": {
