    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "node scripts/bundle-size.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run verify:build && npm run size",
